# Copia este archivo a .env.local y rellena lo que necesites. Nunca subas .env.local.

# --- Datos reales de velocidad (Chrome UX Report) --------------------------------------------
# Gratis. Consola de Google Cloud > APIs > activa "Chrome UX Report API" > Credenciales > Clave de API
# (restringida solo a esa API). Sin clave, el informe cae a los datos de campo de PageSpeed,
# cuya cuota anónima suele estar agotada.
CRUX_API_KEY=
# Opcional: clave para la API de PageSpeed (solo el modo sin CrUX)
PSI_API_KEY=

# --- Ruta y marca ----------------------------------------------------------------------------
# Ruta donde se sirve la app. Vacío = raíz del dominio.
NEXT_PUBLIC_BASE_PATH=/auditor
NEXT_PUBLIC_SITE_URL=https://dazenty.com
# Número para el botón de WhatsApp del informe, con prefijo y sin "+" (p. ej. 34600000000). Vacío = sin botón.
NEXT_PUBLIC_WHATSAPP=

# --- Monitorización propia de visitantes (RUM) -----------------------------------------------
# Dominios autorizados a enviar datos, separados por comas. En producción es obligatorio.
RUM_ALLOWED_HOSTS=ejemplo.com,cliente.com
# Opcional: protege la consulta del panel (?token=... o cabecera Authorization: Bearer ...)
RUM_DASHBOARD_TOKEN=
# Opcional: persistencia en Supabase (crea la tabla con supabase.sql). Sin esto, guarda en data/rum.jsonl.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
